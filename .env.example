# Instellingen voor de scripts in scripts/.
#
# Kopieer dit bestand naar .env en vul het daar in. .env staat in .gitignore en
# hoort daar te blijven: er staat een echt wachtwoord in. Een variabele die al
# in je omgeving staat, wint van wat hier staat.


# --- verbinding met de server ---

# De site draait op Cloud86 (Plesk, paneel op poort 8443, IP 45.82.191.140).
# Poort 21 doet FTP met expliciete TLS, en dat is wat werkt. Op poort 22
# accepteert de server het wachtwoord wel, maar sluit hij het SFTP-kanaal
# meteen: het account heeft geen SSH-toegang, en SFTP loopt via SSH. Krijgt
# het account ooit SSH, zet dan sftp en poort 22.
DDB_PROTOCOL=ftps
DDB_HOST=shared106.cloud86-host.io
DDB_PORT=21

DDB_USER=
DDB_PASS=

# De map waarin WordPress staat, gezien vanaf het account. In Plesk is dat
# httpdocs. Laat leeg om het script zelf te laten zoeken naar wp-config.php.
DDB_ROOT=


# --- de site ---

DDB_URL=https://dickdenbraber.nl
